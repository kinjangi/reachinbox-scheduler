PORT=4000
NODE_ENV=development
# Database connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reachinbox_db?schema=public

# Redis connection string
REDIS_URL=redis://localhost:6379

# CORS setup for frontend
CORS_ORIGIN=http://localhost:3000

# Worker concurrency settings
WORKER_CONCURRENCY=5

# Rate Limiter Settings
MAX_EMAILS_PER_HOUR_PER_SENDER=100
MIN_DELAY_MS_BETWEEN_SENDS=1000

# Elasticsearch Settings
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=emails

# Slack OAuth App Integration (Optional, needed for real notifications)
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_REDIRECT_URI=http://localhost:4000/auth/slack/callback

# SMTP Settings for Ethereal (Test Emails)
# Generate credentials at https://ethereal.email/
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your-ethereal-username
SMTP_PASS=your-ethereal-password
